#!/bin/sh
set -eu
var="${SYNOPKG_PKGVAR:-/var/packages/h5uSynoUsage/var}"
run_collector() {
  export PATH=/usr/syno/bin:/usr/sbin:/usr/bin:/sbin:/bin
  umask 077
  [ "$(id -u)" = 0 ]
  collector=/var/packages/h5uSynoUsage/target/bin/synousage
  work=$(mktemp -d /var/lib/synousage.XXXXXXXXXX)
  trap 'rm -f -- "$work/synousage"; rmdir -- "$work"' 0
  trap 'exit 1' HUP INT TERM
  [ -f "$collector" ]
  head -c 16777216 "$collector" > "$work/synousage"
  printf '%s  %s\n' '__SYNOUSAGE_COLLECTOR_SHA256__' "$work/synousage" | sha256sum -c -
  chmod 0700 "$work/synousage"
  "$work/synousage" collect
}

case "${1:-}" in
  start) mkdir -p "$var"; : > "$var/enabled" ;;
  stop) rm -f "$var/enabled" ;;
  status) test -f "$var/enabled" || exit 3 ;;
  prestart|prestop) exit 0 ;;
  collect) run_collector ;;
  *) echo "Usage: $0 {start|stop|status|collect}" >&2; exit 1 ;;
esac
